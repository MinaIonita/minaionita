# Server-side API base, used by SSR content fetches. Same-host in production.
API_URL="http://127.0.0.1:4000/api"

# Browser-side API base, used by the admin panel at /administrare.
# This origin is also injected into the CSP connect-src by proxy.ts — if it is
# wrong, the admin login fails with "Failed to fetch" while curl still works.
NEXT_PUBLIC_API_URL="https://minaionita.ro/api"
