# Database — every application entity lives here (brief §4)
DATABASE_URL="mysql://user:password@localhost:3306/minaionita"

# AES-256 key for the credential vault and generated contracts (brief §5, §7).
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Never commit the real value and never store it in the database.
ENCRYPTION_KEY=""

# Outbound mail for ticket replies and new-lead notifications (brief §5ter).
# Without SMTP_URL nothing is sent: the lead is still saved and the API logs a
# warning. Gmail needs an App Password, not the account password:
#   smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=""
MAIL_FROM="contact@minaionita.ro"

# Inbox that receives every contact-form submission.
CONTACT_NOTIFY_EMAIL="mina.ionita1@gmail.com"
